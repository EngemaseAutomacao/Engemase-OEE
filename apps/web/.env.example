# Variáveis de ambiente da plataforma web (apps/web).
#
# Copie para apps/web/.env.local (nunca vai para o git) e preencha só o que for usar.
# Variável vazia = não configurada (ex.: sem DATABASE_URL a API dos gateways responde 503).
# NUNCA coloque valores reais neste arquivo: ele é público no repositório.
# Na Vercel, as variáveis são criadas no painel do projeto (Settings → Environment Variables),
# separadas por ambiente: Production, Preview e Development.
#
# Situação de cada uma:
#   [lida hoje]  o código já usa
#   [prevista]   entra com um épico do docs/17 (W1 Sentry, W5 Better Auth, W7/W10 rotinas)
#   [testes]     só para testes e ferramentas locais/CI; não criar na Vercel

# ---------------------------------------------------------------------------
# Banco de dados (Neon Postgres 18)
# ---------------------------------------------------------------------------

# [lida hoje] Conexão da aplicação, COM pooler da Neon (host com "-pooler"). O usuário de login
# precisa ser membro do papel app_user e nunca o dono das tabelas (packages/db/README.md).
# Sem ela, a API dos gateways responde 503 e o build não conecta em nada.
# Na Vercel, a integração da Neon cria esta variável em Production e um branch por Preview.
# Local: um Postgres 18 (ex.: docker run -p 5432:5432 -e POSTGRES_PASSWORD=... postgres:18).
# Formato: postgres://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/engemase?sslmode=require
DATABASE_URL=

# [lida hoje] Máximo de conexões do pool por instância da função (1 a 50; padrão 5).
# Com Fluid compute cada instância atende várias requisições; não suba sem olhar o limite do pooler.
DATABASE_POOL_MAX=5

# [prevista] Conexão DIRETA (sem pooler), com o dono das tabelas, só para aplicar migrações no
# pipeline (o script db:migrate ainda não existe; ver RB-08). Nunca usada pela aplicação.
# A integração da Neon cria com este nome.
# Formato: postgres://dono:senha@ep-xxxx.sa-east-1.aws.neon.tech/engemase?sslmode=require
DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------------------
# Login (Better Auth, W5)
# ---------------------------------------------------------------------------

# Segredo que assina sessões e tokens. Gere com: openssl rand -base64 32
# Um valor diferente por ambiente (Production e Preview). Trocar derruba todas as sessões.
BETTER_AUTH_SECRET=

# Endereço canônico da plataforma: é a única origem confiável do login (sem curinga).
# Obrigatório junto com o segredo: sem os dois, o login fica indisponível.
BETTER_AUTH_URL=http://localhost:3000

# Conexão do Better Auth, com um usuário que HERDA o papel auth_service (ver packages/db/README.md).
# Sem ela usa DATABASE_URL, o que só funciona em banco local com superusuário.
AUTH_DATABASE_URL=

# Exige login nas telas do sistema: true/false. Vazio: exige em produção quando BETTER_AUTH_SECRET
# existe; no next dev, não exige. false deixa o protótipo (dados simulados) navegável sem login.
AUTH_ENFORCED=

# ---------------------------------------------------------------------------
# Monitoramento de erros (Sentry, região da UE) [prevista, W1]
# ---------------------------------------------------------------------------

# DSN do projeto no Sentry para erros do servidor (rotas, API dos gateways).
# Formato: https://<chave-publica>@o<org>.ingest.de.sentry.io/<projeto>
SENTRY_DSN=

# DSN para erros do navegador. NEXT_PUBLIC_ vai para o navegador: só a DSN, nada secreto.
NEXT_PUBLIC_SENTRY_DSN=

# Só no build (envio dos source maps). Segredo: só no painel da Vercel e em secrets do GitHub.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=engemase
SENTRY_PROJECT=engemase-oee

# ---------------------------------------------------------------------------
# Rotinas agendadas (Vercel Cron, L17)
# ---------------------------------------------------------------------------

# Segredo que a Vercel manda no cabeçalho Authorization das rotinas (crons em vercel.json).
# Toda rota de cron confere antes de rodar. Gere com: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------

# [lida pelo Next.js] Desliga a telemetria anônima do Next.js (o CI já usa).
NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------------------------------
# Testes e ferramentas [testes]
# ---------------------------------------------------------------------------

# Liga o teste ponta a ponta plc-sim → agente Go → API → banco (o script test:e2e já liga).
# E2E_GATEWAY=1

# Testes de navegador (Playwright, pnpm --filter web test:navegador):
# PW_PORT=3100                      porta do next start que o Playwright sobe (padrão 3100)
# PW_BASE_URL=https://...vercel.app  testa um endereço já no ar (não sobe servidor)
# PW_CHROMIUM_PATH=/opt/pw-browsers/chromium   outro executável do Chromium

# PoC de carga dos gateways (pnpm --filter web poc:gateways; docs/operacao/poc-100-gateways.md):
# POC_N=5                     gateways simulados
# POC_CICLOS=5                /sync por gateway
# POC_INTERVALO_MS=1000       intervalo entre /sync (o agente usa 10000)
# POC_API_URL=                API de fora (ex.: preview da Vercel); vazio = API no próprio processo
# POC_DATABASE_URL=           Postgres do seed e das conferências (dono das tabelas); vazio = PGlite
# POC_DATABASE_URL_APP=       conexão da API no processo (membro de app_user); padrão = POC_DATABASE_URL
# POC_POOL_MAX=5              pool da API no processo
# POC_MIGRAR=1                aplica as migrações em POC_DATABASE_URL antes (banco vazio)
# POC_META_P99_MS=1000        p99 máximo aceito do /sync
# POC_MAX_ERROS=0             erros aceitos
# POC_RELATORIO=poc.json      grava o resultado em JSON

# ---------------------------------------------------------------------------
# Resumo diário por e-mail (cron /api/cron/resumo-diario, L17) [opcional]
# ---------------------------------------------------------------------------

# Chave do Resend. Sem ela (ou sem remetente/destinatários) o resumo é montado mas não é enviado.
RESEND_API_KEY=
# Remetente verificado no Resend. Ex.: OEE Engemase <oee@exemplo.com.br>
RESUMO_DIARIO_DE=
# Destinatários da equipe Engemase, separados por vírgula.
RESUMO_DIARIO_PARA=

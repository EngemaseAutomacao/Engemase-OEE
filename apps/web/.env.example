# Variáveis de ambiente da plataforma web (apps/web).
#
# Copie para apps/web/.env.local (nunca vai para o git) e preencha só o que for usar.
# Variável vazia = não configurada (ex.: sem DATABASE_URL a API dos gateways responde 503).
# NUNCA coloque valores reais neste arquivo: ele é público no repositório.
# Na Vercel, as variáveis são criadas no painel do projeto (Settings → Environment Variables),
# separadas por ambiente: Production, Preview e Development.
#
# Situação de cada uma:
#   [lida hoje]  o código já usa
#   [prevista]   entra com um épico do docs/17 (W1 Sentry, W5 Better Auth, W7/W10 rotinas)
#   [testes]     só para testes e ferramentas locais/CI; não criar na Vercel

# ---------------------------------------------------------------------------
# Banco de dados (Neon Postgres 18)
# ---------------------------------------------------------------------------

# [lida hoje] Conexão COM pooler da Neon (host com "-pooler"). Na Vercel, a integração da Neon cria esta
# variável com o DONO das tabelas, que o app nunca usa: ele troca usuário e senha pelos logins abaixo
# (lib/server/db-url.ts). Fora da Vercel (dev, testes) vale como está: use um usuário membro de app_user,
# ou o dono/superusuário num banco local.
# Local: um Postgres 18 (ex.: docker run -p 5432:5432 -e POSTGRES_PASSWORD=... postgres:18).
# Formato: postgres://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/engemase?sslmode=require
DATABASE_URL=
# [lida hoje] Máximo de conexões do pool por instância da função (1 a 50; padrão 5).
# Com Fluid compute cada instância atende várias requisições; não suba sem olhar o limite do pooler.
DATABASE_POOL_MAX=5
# [lida hoje] Conexão DIRETA (sem pooler), com o dono das tabelas: aplica as migrações no build de produção
# (pnpm --filter @engemase/db db:migrate, apps/web/vercel.json) e, sem DATABASE_MAINTENANCE_URL, faz a
# manutenção das partições. Nunca usada pelas telas nem pela API. A integração da Neon cria com este nome.
# Formato: postgres://dono:senha@ep-xxxx.sa-east-1.aws.neon.tech/engemase?sslmode=require
DATABASE_URL_UNPOOLED=
# [lida hoje] Senhas dos usuários de login (32 a 128 caracteres: letras, números e . _ ~ -), diferentes entre
# si. O db:migrate do build de produção cria/atualiza os usuários; o app monta os endereços a partir do
# DATABASE_URL. Gere com: openssl rand -base64 33 | tr '+/' '-_'
#   APP_DB_PASSWORD  -> app_login (membro de app_user, só com SET ROLE)
#   AUTH_DB_PASSWORD -> auth_login (herda auth_service, para o Better Auth)
# Na Vercel, sem APP_DB_PASSWORD as telas seguem com dados simulados e a API dos gateways responde 503.
APP_DB_PASSWORD=
AUTH_DB_PASSWORD=
# [opcional] Nomes dos usuários (padrão app_login / auth_login) e endereço completo da aplicação, se não
# quiser o montado a partir do DATABASE_URL.
APP_DB_USER=
AUTH_DB_USER=
APP_DATABASE_URL=
# [lida hoje] 1 = AMBIENTE DE DEMONSTRAÇÃO (projeto engemase-oee-demo na Vercel): o app ignora qualquer banco,
# as migrações não rodam e todas as telas usam os dados simulados, com uma faixa "Ambiente de demonstração" no
# topo. Nunca no projeto real.
ENGEMASE_DEMONSTRACAO=
# [opcional, só Preview] 1 = o build do preview também migra. Só ligue com um branch da Neon por preview;
# sem isso o preview aponta para o banco de produção.
DB_MIGRATE_PREVIEW=
# ---------------------------------------------------------------------------
# Login (Better Auth, W5)
# ---------------------------------------------------------------------------

# Segredo que assina sessões e tokens. Gere com: openssl rand -base64 32
# Um valor diferente por ambiente (Production e Preview). Trocar derruba todas as sessões.
BETTER_AUTH_SECRET=

# Endereço canônico da plataforma: é a única origem confiável do login (sem curinga).
# Obrigatório junto com o segredo: sem os dois, o login fica indisponível.
BETTER_AUTH_URL=http://localhost:3000

# [opcional] Conexão completa do Better Auth, com um usuário que HERDA o papel auth_service. Sem ela: na
# Vercel, DATABASE_URL com auth_login e AUTH_DB_PASSWORD; fora dela, DATABASE_URL como está.
AUTH_DATABASE_URL=

# ---------------------------------------------------------------------------
# E-mail da conta (W5): convite "definir senha", "esqueci minha senha", aviso de conta bloqueada e
# de verificação em duas etapas reiniciada. [opcional]
# ---------------------------------------------------------------------------
# Sem provedor (RESEND_API_KEY ou EMAIL_FROM vazios), nada é enviado: o servidor registra no log o
# destinatário mascarado e o assunto; fora de produção também o texto (com o link), para testar local.
# Em produção, sem provedor, os links NÃO aparecem em lugar nenhum: configure antes de convidar pessoas.
# RESEND_API_KEY é a mesma do resumo diário (seção "Resumo diário por e-mail", abaixo).
# Remetente verificado no Resend (SPF/DKIM do domínio). Ex.: Engemase OEE <nao-responda@exemplo.com.br>
EMAIL_FROM=

# Exige login nas telas do sistema: true/false. Vazio: exige em produção quando BETTER_AUTH_SECRET
# existe; no next dev, não exige. false deixa o protótipo (dados simulados) navegável sem login.
AUTH_ENFORCED=

# ---------------------------------------------------------------------------
# Monitoramento de erros (Sentry, região da UE) [prevista, W1]
# ---------------------------------------------------------------------------

# DSN do projeto no Sentry para erros do servidor (rotas, API dos gateways).
# Formato: https://<chave-publica>@o<org>.ingest.de.sentry.io/<projeto>
SENTRY_DSN=

# DSN para erros do navegador. NEXT_PUBLIC_ vai para o navegador: só a DSN, nada secreto.
NEXT_PUBLIC_SENTRY_DSN=

# Só no build (envio dos source maps). Segredo: só no painel da Vercel e em secrets do GitHub.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=engemase
SENTRY_PROJECT=engemase-oee

# ---------------------------------------------------------------------------
# Rotinas agendadas (Vercel Cron, L17)
# ---------------------------------------------------------------------------

# Segredo que a Vercel manda no cabeçalho Authorization das rotinas (crons em vercel.json).
# Toda rota de cron confere antes de rodar. Gere com: openssl rand -hex 32
CRON_SECRET=

# [lida hoje, opcional] Conexão de MANUTENÇÃO para a limpeza diária (/api/cron/limpeza) criar as partições
# futuras e apagar as vencidas de production_minute e tag_sample (maintainPartitions(), DDL). Precisa ser o
# papel DONO das tabelas (o mesmo das migrações), conexão DIRETA (sem "-pooler"). Vazia: usa o
# DATABASE_URL_UNPOOLED da integração. A tarefa abre uma conexão e fecha no fim. Sem nenhuma das duas, a limpeza registra no log e pula as
# partições, sem falhar (a migração 0013 deixou 3 meses / 8 semanas criados adiante).
# Formato: postgres://dono:senha@ep-xxxx.sa-east-1.aws.neon.tech/engemase?sslmode=require
DATABASE_MAINTENANCE_URL=

# [lida hoje, opcional] Quantos dias a auditoria (audit_log) fica guardada; a limpeza diária apaga o que for
# mais velho. Vazia: 1825 (5 anos, D6). Mínimo 365 (o banco recusa menos). Valor inválido: não limpa e avisa.
AUDITORIA_RETENCAO_DIAS=

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------

# [lida pelo Next.js] Desliga a telemetria anônima do Next.js (o CI já usa).
NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------------------------------
# Testes e ferramentas [testes]
# ---------------------------------------------------------------------------

# Liga o teste ponta a ponta plc-sim → agente Go → API → banco (o script test:e2e já liga).
# E2E_GATEWAY=1

# Testes de navegador (Playwright, pnpm --filter web test:navegador):
# PW_PORT=3100                      porta do next start que o Playwright sobe (padrão 3100)
# PW_BASE_URL=https://...vercel.app  testa um endereço já no ar (não sobe servidor)
# PW_CHROMIUM_PATH=/opt/pw-browsers/chromium   outro executável do Chromium

# PoC de carga dos gateways (pnpm --filter web poc:gateways; docs/operacao/poc-100-gateways.md):
# POC_N=5                     gateways simulados
# POC_CICLOS=5                /sync por gateway
# POC_INTERVALO_MS=1000       intervalo entre /sync (o agente usa 10000)
# POC_API_URL=                API de fora (ex.: preview da Vercel); vazio = API no próprio processo
# POC_DATABASE_URL=           Postgres do seed e das conferências (dono das tabelas); vazio = PGlite
# POC_DATABASE_URL_APP=       conexão da API no processo (membro de app_user); padrão = POC_DATABASE_URL
# POC_POOL_MAX=5              pool da API no processo
# POC_MIGRAR=1                aplica as migrações em POC_DATABASE_URL antes (banco vazio)
# POC_META_P99_MS=1000        p99 máximo aceito do /sync
# POC_MAX_ERROS=0             erros aceitos
# POC_RELATORIO=poc.json      grava o resultado em JSON

# ---------------------------------------------------------------------------
# Resumo diário por e-mail (cron /api/cron/resumo-diario, L17) [opcional]
# ---------------------------------------------------------------------------

# Chave do Resend. Sem ela (ou sem remetente/destinatários) o resumo é montado mas não é enviado.
# Também usada pelos e-mails da conta (com EMAIL_FROM, seção do login).
RESEND_API_KEY=
# Remetente verificado no Resend. Ex.: OEE Engemase <oee@exemplo.com.br>
RESUMO_DIARIO_DE=
# Destinatários da equipe Engemase, separados por vírgula.
RESUMO_DIARIO_PARA=

# Atualização do agente pela nuvem (GitHub Releases). Opcionais: o repositório é público.
# GITHUB_TOKEN=          # só leitura de conteúdo; sobe o limite da API do GitHub
# GATEWAY_RELEASES_REPO=EngemaseAutomacao/Engemase-OEE

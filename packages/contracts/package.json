{
  "name": "@engemase/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Contrato gateway ↔ nuvem v1 (schemas Zod 4, JSON Schema e fixtures)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schema/*": "./schema/*",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "src",
    "schema",
    "fixtures"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:schema": "tsx scripts/build-schema.ts",
    "build:fixtures": "tsx scripts/build-fixtures.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}

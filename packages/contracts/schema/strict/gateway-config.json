                      }
                    ]
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535,
                    "description": "Porta TCP (padrão Modbus: 502)"
                  },
                  "unit_id": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255,
                    "description": "Unit id Modbus TCP (0–255; normalmente 1)"
                  },
                  "timeout_ms": {
                    "type": "integer",
                    "minimum": 50,
                    "maximum": 10000
                  }
                },
                "required": [
                  "host",
                  "port",
                  "unit_id"
                ],
                "additionalProperties": false

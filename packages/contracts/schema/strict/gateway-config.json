                            "coil",
                            "discrete_input",
                            "input_register",
                            "holding_register"
                          ]
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 65535,
                          "description": "Offset Modbus em base 0 (0–65535)"
                        },
                        "bit": {
                          "description": "Bit (0 = menos significativo) para type bool em registrador",
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 15
                        }
                      },
                      "required": [
                        "area",
                        "offset"
                      ],
                      "additionalProperties": false
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "bool",
                        "int16",

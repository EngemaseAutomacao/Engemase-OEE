{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oee.engemase.com.br/schemas/gateway/v1/strict/gateway-config.json",
  "title": "GET /config — resposta 200",
  "description": "Configuração completa do gateway: barramentos, dispositivos Modbus, blocos, tags, máquinas e uplink. Contrato gateway ↔ nuvem v1. Gerado de @engemase/contracts; não edite à mão.",
  "type": "object",
  "properties": {
    "config_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Versão monotônica da config (aumenta a cada publicação)"
    },
    "gateway_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "Id de entidade (UUID; a nuvem gera UUIDv7)"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "Timestamp ISO 8601 em UTC com sufixo Z"
    },
    "serial_buses": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Id de entidade (UUID; a nuvem gera UUIDv7)"
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "port": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(?:\\/dev\\/[A-Za-z0-9._/-]+|[a-z][a-z0-9-]{0,31})$",
            "description": "Porta serial lógica (rs485-1) ou caminho /dev/..."
          },
          "baud": {
            "type": "number",
            "enum": [
              1200,
              2400,
              4800,
              9600,
              19200,
              38400,
              57600,
              115200
            ]
          },
          "parity": {
            "type": "string",
            "enum": [
              "N",
              "E",
              "O"
            ]
          },
          "data_bits": {
            "type": "number",
            "const": 8,
            "description": "Modbus RTU usa sempre 8 bits de dados"
          },
          "stop_bits": {
            "type": "number",
            "enum": [
              1,
              2
            ]
          }
        },
        "required": [
          "id",
          "port",
          "baud",
          "parity",
          "data_bits",
          "stop_bits"
        ],
        "additionalProperties": false
      }
    },
    "devices": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "description": "Id de entidade (UUID; a nuvem gera UUIDv7)"
              },
              "name": {
                "type": "string",
                "maxLength": 120
              },
              "enabled": {
                "description": "false = dispositivo cadastrado, mas não lido (padrão: true)",
                "type": "boolean"
              },
              "blocks": {
                "maxItems": 256,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "area": {
                      "type": "string",
                      "enum": [
                        "coil",
                        "discrete_input",
                        "input_register",
                        "holding_register"
                      ]
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65535,
                      "description": "Offset Modbus em base 0 (0–65535)"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2000,
                      "description": "Até 125 registradores ou 2000 bits"
                    },
                    "poll_ms": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 3600000
                    }
                  },
                  "required": [
                    "area",
                    "start",
                    "count",
                    "poll_ms"
                  ],
                  "additionalProperties": false
                }
              },

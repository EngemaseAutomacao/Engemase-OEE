                    "address",
                    "type",
                    "role"
                  ],
                  "additionalProperties": false
                }
              },
              "protocol": {
                "type": "string",
                "const": "modbus-tcp"
              },
              "params": {
                "type": "object",
                "properties": {
                  "host": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "ipv4",
                        "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$"

                          "type": "number"
                        },
                        "add": {
                          "type": "number"
                        }
                      },
                      "additionalProperties": false
                    },
                    "poll_ms": {
                      "description": "Obrigatório para tag fora de bloco; proibido dentro de bloco",
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 3600000
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "state.running",
                        "state.fault",
                        "state.code",
                        "fault.code",
                        "count.total",
                        "count.good",
                        "count.reject",
                        "product.code",
                        "speed.actual",
                        "plc.heartbeat",
                        "custom"

                  },
                  "comm_loss_after_s": {
                    "description": "Segundos sem leitura boa até NO_COMM (padrão: 10)",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3600
                  },
                  "debounce_s": {
                    "description": "Debounce de mudança de estado (padrão: 1 s)",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 60
                  },
                  "heartbeat_timeout_s": {
                    "description": "Heartbeat parado por mais que isso vira NO_COMM (exige tag plc.heartbeat)",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3600
                  }
                },
                "required": [
                  "mode"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "state_code"
                  },
                  "map": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^(?:0|-?[1-9]\\d{0,9})$"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "enum": [
                        "RUNNING",
                        "STOPPED",
                        "FAULT",
                        "SETUP"
                      ]
                    },
                    "description": "Código do CLP → estado OEE"
                  },
                  "default_state": {
                    "description": "Estado para códigos fora do mapa (padrão: STOPPED)",
                    "type": "string",
                    "enum": [
                      "RUNNING",
                      "STOPPED",
                      "FAULT",
                      "SETUP"
                    ]
                  },
                  "comm_loss_after_s": {
                    "description": "Segundos sem leitura boa até NO_COMM (padrão: 10)",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3600
                  },
                  "debounce_s": {
                    "description": "Debounce de mudança de estado (padrão: 1 s)",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 60
                  },
                  "heartbeat_timeout_s": {
                    "description": "Heartbeat parado por mais que isso vira NO_COMM (exige tag plc.heartbeat)",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3600
                  }
                },
                "required": [
                  "mode",
                  "map"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "count_derived"
                  },
                  "ideal_cycle_s": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 86400,
                    "description": "Tempo de ciclo ideal (s)"
                  },
                  "idle_after_cycles": {
                    "description": "Ciclos sem peça até parada (padrão: 3)",
                    "type": "number",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "comm_loss_after_s": {
                    "description": "Segundos sem leitura boa até NO_COMM (padrão: 10)",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3600
                  },
                  "debounce_s": {
                    "description": "Debounce de mudança de estado (padrão: 1 s)",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 60
                  },
                  "heartbeat_timeout_s": {
                    "description": "Heartbeat parado por mais que isso vira NO_COMM (exige tag plc.heartbeat)",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3600
                  }
                },
                "required": [
                  "mode",
                  "ideal_cycle_s"
                ],
                "additionalProperties": false
              }
            ]
          },
          "max_rate_per_s": {
            "description": "Taxa máxima plausível de peças/s (sanidade dos contadores)",
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100000
          }
        },
        "required": [
          "id",
          "state_rules"
        ],
        "additionalProperties": false
      }
    },
    "uplink": {
      "type": "object",
      "properties": {
        "sync_interval_s": {
          "type": "integer",

                        "pattern": "^(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
                      }
                    ]
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "unit_id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 247,
                    "description": "Unit id (1–247)"
                  },
                  "timeout_ms": {
                    "type": "integer",
                    "minimum": 50,
                    "maximum": 10000
                  }
                },
                "required": [
                  "host",
                  "port",
                  "unit_id"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "tags",
              "protocol",
              "params"
            ],
            "additionalProperties": false
          }
        ]
      }

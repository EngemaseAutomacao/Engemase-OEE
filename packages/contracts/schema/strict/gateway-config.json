                    },
                    "machine_id": {
                      "description": "Obrigatório exceto para o papel custom",
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "sampling": {
                      "type": "object",
                      "properties": {
                        "deadband": {
                          "description": "Variação mínima para gerar nova amostra",
                          "type": "number",
                          "minimum": 0

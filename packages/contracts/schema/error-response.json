{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oee.engemase.com.br/schemas/gateway/v1/error-response.json",
  "title": "Resposta de erro",
  "description": "Corpo padrão das respostas 4xx/5xx da API dos gateways. Contrato gateway ↔ nuvem v1. Gerado de @engemase/contracts; não edite à mão.",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_payload",
            "unknown_reference",
            "timestamp_out_of_range",
            "activation_code_invalid",
            "unauthorized",
            "token_revoked",
            "not_found",
            "config_outdated",
            "activation_code_expired",
            "activation_code_used",
            "payload_too_large",
            "unsupported_media_type",
            "rate_limited",
            "internal_error",
            "service_unavailable"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        },
        "retry_after_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "issues": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  ]
                }
              },
              "message": {
                "type": "string",
                "maxLength": 2000
              },
              "rule": {
                "description": "Id da regra semântica (params.rule), quando houver",
                "type": "string",
                "maxLength": 64
              }
            },
            "required": [
              "path",
              "message"
            ]
          }
        },
        "request_id": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  },
  "required": [
    "error"
  ]
}

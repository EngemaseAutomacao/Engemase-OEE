# Acesso do agente (usuário oee, sem root) ao hardware do R1000 (docs/16 §3 e §6).
# Instalado em /usr/lib/udev/rules.d/70-oee-gateway.rules.
# Em PCs de bancada sem esses dispositivos as regras simplesmente não casam.

# --- RS-485 -------------------------------------------------------------------
# As 3 RS-485 isoladas do R1000 são UART2/3/4 do CM4 -> ttyAMA2, ttyAMA3 e
# ttyAMA5 (overlay reComputer-R100x; docs/03 e rascunho de software §2.9).
# Os nomes lógicos rs485-1..3 são os mesmos do agente (config.R1000SerialPorts):
# o agente abre /dev/ttyAMA*; os links /dev/oee/rs485-N são para o técnico e o
# diagnóstico. CONFIRMAR NA BANCADA: qual borne é cada ttyAMA (vai na etiqueta).
# Grupo dialout 0660 (padrão do Debian, explícito aqui) e fora do alcance do
# ModemManager, que mandaria comandos AT no barramento se estivesse instalado.
SUBSYSTEM=="tty", KERNEL=="ttyAMA2", GROUP="dialout", MODE="0660", SYMLINK+="oee/rs485-1", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="tty", KERNEL=="ttyAMA3", GROUP="dialout", MODE="0660", SYMLINK+="oee/rs485-2", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="tty", KERNEL=="ttyAMA5", GROUP="dialout", MODE="0660", SYMLINK+="oee/rs485-3", ENV{ID_MM_DEVICE_IGNORE}="1"

# --- LEDs USER ----------------------------------------------------------------
# led-red, led-green e led-blue no expansor PCA9535 (três LEDs separados;
# "âmbar" = vermelho + verde). Os atributos do sysfs não têm GROUP=/MODE=, então
# um script ajusta brightness e trigger para o grupo oee. delay_on/delay_off só
# aparecem com o gatilho "timer"; o kernel emite um evento "change"
# (TRIGGER=timer) e a mesma regra ajusta esses também. CONFIRMAR NA BANCADA.
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="led-red|led-green|led-blue", RUN+="/usr/lib/oee-gateway/oee-led-perms %S%p"

# --- Buzzer e GPIO (F2: gateway.identify e sinal de falta de energia) -----------
# Buzzer como gpio-beeper (dispositivo de entrada com EV_SND). O nome do
# dispositivo de entrada vem do device tree da Seeed: CONFIRMAR NA BANCADA.
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="*beeper*|*buzzer*", GROUP="oee", MODE="0660", SYMLINK+="oee/buzzer"

# GPIO: grupo gpio, igual ao Raspberry Pi OS (99-com.rules), para funcionar
# também sem ele.
SUBSYSTEM=="gpio", KERNEL=="gpiochip*", GROUP="gpio", MODE="0660"

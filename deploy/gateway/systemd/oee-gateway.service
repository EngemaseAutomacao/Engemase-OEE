# Agente de coleta do gateway OEE (docs/16 §3): usuário oee, sem root.
# Instalado em /usr/lib/systemd/system/. Ajustes locais: drop-in em
# /etc/systemd/system/oee-gateway.service.d/*.conf (nunca editar este arquivo).
#
# Contrato com o código (gateway/internal/app), conferido na Fase 0:
#  - envia READY=1 depois de abrir o buffer e aplicar a última config salva, e
#    STOPPING=1 ao receber SIGTERM (sd_notify próprio, sem cgo);
#  - envia WATCHDOG=1 + STATUS= a cada WatchdogSec/3 (10 s) SÓ se, com config
#    carregada, passarem as três checagens de saúde (docs/16 §3): motor com
#    tick nos últimos 5 s (contados do fim da última gravação); gravação no
#    SQLite sem ficar presa mais de 30 s nem deixar de ser tentada; e cada
#    leitor (poller) vivo dentro de max(3 × (maior poll + pior leitura), 30 s),
#    prazo estendido durante backoff e enquanto espera o motor consumir.
#    Falha em uma delas: log warn "watchdog não alimentado" e aquele ping não
#    vai; o systemd só reinicia depois de WatchdogSec (30 s) sem nenhum ping;
#  - NÃO usa ativação por socket (agent.sock/ui.sock são da Fase 1).
[Unit]
Description=Engemase OEE - agente de coleta do gateway
Documentation=file:/usr/share/doc/oee-gateway/README.md
# A coleta não espera internet nem NTP (docs/16 §1). network.target só ordena a
# parada: no desligamento, o agente para antes da rede (último /sync possível).
After=network.target
# Estado em /var/lib/oee-gateway (bind de /data/oee no R1000). Se a partição de
# dados falhar, o agente NÃO sobe gravando na raiz.
RequiresMountsFor=/var/lib/oee-gateway
# Nunca desistir de religar (equipamento sem operador).
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/oee-gateway run --config /etc/oee-gateway/gateway.yaml
# LED de "erro crítico (agente)" (docs/16 §6): aceso piscando pelo gatilho
# "timer" do kernel enquanto o agente estiver parado; apagado ao (re)iniciar.
# O agente da Fase 0 ainda não acende os outros estados da tabela de LEDs.
ExecStartPre=-/usr/lib/oee-gateway/oee-led-fault clear
ExecStopPost=-/usr/lib/oee-gateway/oee-led-fault set
# Proxy corporativo (HTTPS_PROXY/NO_PROXY, lido pelo agente). Na Fase 1 é gerado
# pelo oee-helper a partir do network.json (docs/16 §4); na Fase 0 é escrito à
# mão na bancada (README §6).
EnvironmentFile=-/etc/oee-gateway/proxy.env
Environment=GOMEMLIMIT=120MiB
# Pilhas de todas as goroutines no journal quando o watchdog mata o processo
# (SIGABRT) ou em pânico: diagnóstico de travamento.
Environment=GOTRACEBACK=all
User=oee
Group=oee
# dialout: RS-485 (/dev/ttyAMA2/3/5, /dev/ttyUSB*); gpio: sinal de falta de
# energia (F2); systemd-journal: logs.upload (F2). LEDs: grupo oee (regra udev).
SupplementaryGroups=dialout gpio systemd-journal
StateDirectory=oee-gateway
StateDirectoryMode=0750
UMask=0027

Restart=always
RestartSec=5s
# systemd >= 254 (Trixie): espera crescente entre reinícios, até 60 s.
# No Bookworm (252, plano B) estas chaves são ignoradas com aviso.
RestartSteps=5
RestartMaxDelaySec=60s
WatchdogSec=30s
TimeoutStartSec=60s
# Parada (SIGTERM): os leitores voltam primeiro, e a leitura em curso termina pelo
# prazo e o Close espera a linha quieta antes de soltá-la (resposta atrasada não pode
# cair no próximo leitor). Com timeout_ms no máximo (10 s): até 10 s no Modbus TCP,
# 30 s no RS-485 e 60 s no conversor RTU sobre TCP, com o ACK da requisição chegando
# no limite do escoamento e a linha falando (poller.StopBound). Depois vêm a gravação
# final, o agent_stop e o fechamento do buffer (20 s, a parada inteira de antes).
# Conferido por TestTimeoutStopSecCobreAParadaDosPollers (internal/poller).
TimeoutStopSec=80s

# Prioridade e recursos (R1000: 4 núcleos, 2 GB).
OOMScoreAdjust=-500
Nice=-5
CPUQuota=100%
MemoryHigh=150M
MemoryMax=256M
TasksMax=256
LimitNOFILE=4096

# Hardening (meta: "systemd-analyze security oee-gateway" <= 2,0).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/oee-gateway
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
DevicePolicy=closed
# Seriais: R1000 (ttyAMA2/3/5) e bancada (adaptador USB-RS485). Os nomes vêm de
# /proc/devices; o driver precisa estar carregado quando o serviço sobe.
# CONFIRMAR NA BANCADA: nomes em /proc/devices do kernel fixado.
DeviceAllow=char-ttyAMA rw
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw
# GPIO (falta de energia; buzzer por GPIO direto) e buzzer gpio-beeper
# (dispositivo de entrada EV_SND), F2. Acesso real limitado pelo dono do nó.
DeviceAllow=char-gpiochip rw
DeviceAllow=char-input rw
ProtectKernelTunables=yes
# LEDs USER do R1000 (led-red/green/blue). O systemd segue o link simbólico de
# /sys/class/leds até o dispositivo. CONFIRMAR NA BANCADA; plano B: drop-in com
# ProtectKernelTunables=no.
ReadWritePaths=-/sys/class/leds/led-red -/sys/class/leds/led-green -/sys/class/leds/led-blue
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
# Bloqueia adjtimex: o estado do NTP deve ser lido pelo D-Bus (timedate1).
ProtectClock=yes
ProtectHostname=yes
# Não usar ProcSubset=pid: a saúde lê /proc/stat, /proc/meminfo e /proc/loadavg.
ProtectProc=invisible
# AF_INET6 fica liberado só para o Go não falhar ao sondar IPv6 (o IPv6 está
# desligado por sysctl e pelo nftables). AF_NETLINK: lista de interfaces.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
# O runtime do Go tenta subir o limite de arquivos (setrlimit, @resources) e
# ignora o EPERM. CONFIRMAR NA BANCADA com o binário real.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target

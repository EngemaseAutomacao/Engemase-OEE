# Pacote oee-gateway-remote-access. Um sshd por conexão (modo inetd), aberto pelo oee-sshd.socket.
# A configuração é a do pacote (/usr/share/oee-remote-access/ssh/sshd_config), não a do sistema.
[Unit]
Description=Engemase OEE - sessão SSH do acesso remoto
Documentation=file:/usr/share/doc/oee-gateway-remote-access/README.md
ConditionPathExists=/var/lib/oee-remote-access/ssh/ssh_host_ed25519_key

[Service]
Type=exec
ExecStart=-/usr/sbin/sshd -i -f /usr/share/oee-remote-access/ssh/sshd_config
StandardInput=socket
StandardError=journal
RuntimeDirectory=sshd
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0755
KillMode=process
TasksMax=64
MemoryMax=128M

# FASE 1 — CÓDIGO PRONTO, NÃO EMPACOTADO AINDA: entra no nfpm.yaml (e no
# postinst/prerm/postrm/install.sh) depois da conferência na bancada
# (docs/operacao/verificacao-bancada-r1000.md). Ver deploy/gateway/README.md §1.
#
# Socket entre a página local (oee-localui, usuário oee-ui) e o agente
# (gateway/internal/localapi). Só leitura: GET /v1/status (conexões, últimas
# leituras, fila e nuvem). O agente confere o chamador por SO_PEERCRED (grupo
# oee-ui, o próprio oee ou root). O login e as sessões ficam na página; uma
# página comprometida só lê esse retrato: nenhuma rota escreve, e a página não
# tem acesso ao buffer nem à credencial (docs/16 §3 e §6).
[Unit]
Description=Engemase OEE - API local do agente (página local)
Documentation=file:/usr/share/doc/oee-gateway/README.md

[Socket]
ListenStream=/run/oee-gateway/ui.sock
SocketUser=oee
SocketGroup=oee-ui
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes
FileDescriptorName=ui
Service=oee-gateway.service

[Install]
WantedBy=sockets.target

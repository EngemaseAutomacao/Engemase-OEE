# sudo restrito do usuário tecnico (docs/16 §4). Instalado em
# /etc/sudoers.d/oee-tecnico (conffile, modo 0440).
#
# Só os subcomandos explícitos: status, diag, net show/set/confirm/rollback e
# enroll --code. SEM reset de fábrica, URL personalizada ou acesso remoto.
#
# Os comandos rodam como o usuário do AGENTE (oee), não como root:
#  - o enroll grava /var/lib/oee-gateway/credentials.json com o dono certo
#    (0600 oee; gravado por root, o agente não conseguiria ler);
#  - o firewall só deixa o usuário oee sair na 443 (nftables, skuid);
#  - privilégio mínimo: nada aqui precisa de root.
# Com runas_default=oee, o técnico digita só "sudo oee-gateway ..." (sem -u).
#
# Os argumentos são conferidos por expressão regular (^...$, sudo >= 1.9.10;
# o pacote declara Breaks: sudo (<< 1.9.10)). O sudo junta os argumentos com
# espaço e compara a linha inteira: qualquer opção fora da lista (ex.: --url,
# --config, --force, --hostname) é recusada. Ao mudar a CLI (gateway/),
# atualizar AQUI e a matriz de testes do validate.sh.
#
# Fase 0 (existem no agente hoje): diag e enroll.
# Fase 1 (subcomandos ainda não existem; a CLI responde "unknown command"):
# status e net show/set/confirm/rollback (net passa pelo oee-helper).
#
# Validar: visudo -cf deploy/gateway/sudoers.d/oee-tecnico
#          deploy/gateway/validate.sh (matriz de permitidos e negados)

Defaults:tecnico runas_default=oee
Defaults:tecnico use_pty
Defaults:tecnico log_output
Defaults:tecnico timestamp_timeout=5
Defaults:tecnico env_reset

# Diagnóstico e estado (leitura).
Cmnd_Alias OEE_TEC_LEITURA = /usr/bin/oee-gateway ^diag( --json)?$, \
                             /usr/bin/oee-gateway ^status( --json)?$, \
                             /usr/bin/oee-gateway ^net show( --json)?$

# Rede (Fase 1): preparar com checkpoint e volta automática em 120 s,
# confirmar ou desfazer. Cada argumento é uma opção da lista ou um valor que
# não começa com "-". A lista de opções de "net set" acompanha a CLI da Fase 1.
Cmnd_Alias OEE_TEC_REDE = /usr/bin/oee-gateway ^net set (it|ot|proxy|ntp)( (--(static|dhcp|gw|dns|dns-search|address|add-address|del-address|route|del-route|vlan|no-vlan|mtu|no-proxy)|[^ -][^ ]*))*$, \
                          /usr/bin/oee-gateway ^net (confirm|rollback)$

# Ativação com código (mesmo formato do contrato: ABCD-1234). Sem --url.
Cmnd_Alias OEE_TEC_ATIVACAO = /usr/bin/oee-gateway ^enroll --code [A-Za-z0-9]{4}-?[A-Za-z0-9]{4}$

tecnico ALL = (oee) OEE_TEC_LEITURA, OEE_TEC_REDE, OEE_TEC_ATIVACAO

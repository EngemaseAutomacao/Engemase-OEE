#!/bin/sh
# prerm do pacote oee-gateway. Idempotente; respeita DPKG_ROOT.
# Na remoção, para os serviços e os sockets. Na atualização não para nada: o
# postinst da versão nova reinicia só o necessário (menos tempo sem coleta).
set -e
set -f

ROOT="${DPKG_ROOT:-}"

systemd_running() {
	[ -z "$ROOT" ] && [ -d /run/systemd/system ]
}

stop_all() {
	# Fase 0: só o agente. O bind de /data/oee fica montado até o próximo boot
	# (não há o que desmontar com pressa; o buffer continua lá).
	systemctl stop oee-gateway.service >/dev/null 2>&1 || true
}

case "$1" in
	remove | deconfigure)
		if systemd_running; then
			stop_all
		fi
		;;
	upgrade | failed-upgrade)
		;;
	*)
		echo "prerm chamado com argumento desconhecido: '$1'" >&2
		exit 1
		;;
esac

exit 0

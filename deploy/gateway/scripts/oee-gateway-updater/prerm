#!/bin/sh
# prerm do pacote oee-gateway-updater. Idempotente; respeita DPKG_ROOT.
# Na remoção, só para a vigilância (.path). Não para o oee-gateway-updater.service:
# se ele estiver rodando, é ele quem chamou o dpkg.
set -e
set -f

ROOT="${DPKG_ROOT:-}"

case "$1" in
	remove | deconfigure)
		if [ -z "$ROOT" ] && [ -d /run/systemd/system ]; then
			systemctl stop oee-gateway-updater.path >/dev/null 2>&1 || true
		fi
		;;
	upgrade | failed-upgrade)
		;;
	*)
		echo "prerm chamado com argumento desconhecido: '$1'" >&2
		exit 1
		;;
esac

exit 0

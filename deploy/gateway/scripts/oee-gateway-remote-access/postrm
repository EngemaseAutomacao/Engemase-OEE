#!/bin/sh
# postrm do pacote oee-gateway-remote-access. Idempotente; respeita DPKG_ROOT.
# O purge não apaga o usuário oee-ra (a imagem também o declara) nem a política
# local /etc/oee-gateway/remote-access.json (é do cliente).
set -e
set -f

ROOT="${DPKG_ROOT:-}"
UNIT=oee-remote-access.socket

systemd_running() {
	[ -z "$ROOT" ] && [ -d /run/systemd/system ]
}

case "$1" in
	remove)
		if systemd_running; then
			systemctl daemon-reload || true
		fi
		;;
	purge)
		if [ -z "$ROOT" ] && command -v deb-systemd-helper >/dev/null 2>&1; then
			deb-systemd-helper purge "$UNIT" >/dev/null || true
		else
			set +f
			for link in "$ROOT"/etc/systemd/system/*.wants/"$UNIT"; do
				if [ -L "$link" ]; then rm -f "$link"; fi
			done
			set -f
		fi
		if systemd_running; then
			systemctl daemon-reload || true
		fi
		;;
	upgrade | failed-upgrade | abort-install | abort-upgrade | disappear)
		;;
	*)
		echo "postrm chamado com argumento desconhecido: '$1'" >&2
		exit 1
		;;
esac

exit 0

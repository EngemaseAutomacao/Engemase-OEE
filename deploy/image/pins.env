# Versões fixadas da imagem do gateway Engemase (lido pelo build.sh com "source").
#
# Regra: mesmo commit do rpi-image-gen + mesmo snapshot do Debian + mesmos .deb
# de plataforma = mesmos pacotes na imagem. Qualquer mudança aqui gera uma
# imagem nova (nova versão em <debian>.<ano>.<mês>.<n>).
#
# Só atribuições simples KEY=valor (sem comandos): o build.sh valida o formato.

# rpi-image-gen (ferramenta oficial da Raspberry Pi). Lido em 05/11/2026.
EGW_RPI_IMAGE_GEN_URL=https://github.com/raspberrypi/rpi-image-gen.git
EGW_RPI_IMAGE_GEN_COMMIT=fb44a4cde4ac54847ef1966957149e2c2b716fdf

# Overlays e driver do RTC da Seeed (fonte do pacote engemase-r1000-support).
# Lido em 21/10/2026. O script da Seeed NUNCA roda na unidade.
EGW_SEEED_OVERLAYS_URL=https://github.com/Seeed-Studio/seeed-linux-dtoverlays.git
EGW_SEEED_OVERLAYS_COMMIT=1d53c3cf2c96bd5ca2b2b7b9cbb198d398e4031c

# Snapshot do Debian (snapshot.debian.org), formato AAAAMMDDTHHMMSSZ.
# O build converte em SOURCE_DATE_EPOCH, que o rpi-image-gen usa para escolher
# o snapshot. O repositório da Raspberry Pi NÃO tem snapshot: por isso o kernel
# e o firmware são fixados por versão (EGW_KERNEL_ABI) e, de preferência,
# vêm de .deb guardados em debs/platform/.
EGW_DEBIAN_SNAPSHOT=20261101T000000Z

# ABI do kernel fixado (nome do pacote linux-image-<ABI>). Vazio = Fase 0:
# usa o kernel atual do repositório, registra a ABI e só avisa.
# Exemplo de formato (A CONFIRMAR na Fase 0): 6.12.47+rpt-rpi-v8
EGW_KERNEL_ABI=

# Versão do "pacote de plataforma" (kernel + firmware + engemase-r1000-support).
EGW_PLATFORM_VERSION=6.12.x-egw1

# Hardware esperado do lote (autoteste B0). Série R10xx-00: 2 GB de RAM, 16 GB de eMMC.
EGW_EXPECT_RAM_GB=2
EGW_EXPECT_EMMC_GB=16

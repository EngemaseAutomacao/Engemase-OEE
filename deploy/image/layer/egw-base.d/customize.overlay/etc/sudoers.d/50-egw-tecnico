# Engemase: sudo do usuário de console "tecnico" (docs/16 §4).
# Só subcomandos explícitos. SEM reset de fábrica, URL personalizada ou
# acesso remoto. Atenção: o "*" do sudo aceita qualquer argumento; a CLI
# (oee-gateway) precisa recusar --url e afins quando SUDO_USER=tecnico.
Cmnd_Alias EGW_TECNICO = \
	/usr/bin/oee-gateway status, /usr/bin/oee-gateway status *, \
	/usr/bin/oee-gateway diag, /usr/bin/oee-gateway diag *, \
	/usr/bin/oee-gateway net show, /usr/bin/oee-gateway net show *, \
	/usr/bin/oee-gateway net set *, \
	/usr/bin/oee-gateway net confirm, /usr/bin/oee-gateway net confirm *, \
	/usr/bin/oee-gateway net rollback, /usr/bin/oee-gateway net rollback *, \
	/usr/bin/oee-gateway enroll --code *

Defaults:tecnico use_pty, log_output, iolog_dir=/data/journal/sudo-io, timestamp_timeout=5
tecnico ALL=(root) EGW_TECNICO
